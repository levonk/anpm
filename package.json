{
  "name": "anpm",
  "version": "0.1.0",
  "description": "A wrapper for various Node.js package managers",
  "type": "module",
  "bin": {
    "anpm": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "lint-and-fix": "eslint --fix src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "package manager",
    "wrapper",
    "npm",
    "yarn",
    "pnpm",
    "bun"
  ],
  "author": "levonk",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^20.19.9",
    "eslint": "^8.57.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "dependencies": {
    "zx": "^7.2.4"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}